{
  "manifest_version": 3,
  "name": "Akarna",
  "version": "0.1.0",
  "description": "A safe, conversational form assistant.",
  "permissions": ["storage", "sidePanel", "scripting", "microphone"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Open Akarna"
  }
}
